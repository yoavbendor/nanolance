# Never commit or ship this tree in source archives — it holds FetchContent clones
# (nanoarrow/zstd/CLI11 with .git) plus objects; often 100MB+ while the library sources are ~1–2MB.
/build/
/build-*/
/bindings/python/build/
/.deps/
/.deps-*/
/.cache/
*.rej
CMakeLists.txt.user
compile_commands.json

# Python bytecode + packaging/test scratch. A stale .pyc was tracked in
# examples/pcapng2lance/tests/ for a Python version nobody here runs.
__pycache__/
*.py[cod]
*.egg-info/
/.pytest_cache/

# Sourcetrail IDE index (st_nl.srctrldb was ~4.9MB of the repo's 22.8MB). Regenerate locally from
# st_nl.srctrlprj; there is no reason for a consumer's clone to carry one developer's index.
*.srctrldb
*.srctrlbm

# Local-only GPU (gputins) work-in-progress: removed from the public nanotins repo and the
# pcapng2lance example for now; kept here to develop on a CUDA box. Re-introduce when ready.
/local-gputins/
build2/

# MkDocs build output + docs pages copied in at deploy time from their canonical location
# (.github/workflows/pages.yml) — never committed, always freshly generated from main.
/site/
docs/agents.md
docs/bench-write-read.md
docs/bench-trusted-parity.md
